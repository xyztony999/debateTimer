# 推荐：本地前端通过 Vite 代理连远程或本机 API（cookie 同站）
VITE_API_BASE_URL=
# VITE_DEV_API_PROXY=https://api.debatetimer.tonyxyz.com

# 若直连远程（需远程 CORS 允许 http://localhost:3000，且 cookie SameSite 适配跨站）：
# VITE_API_BASE_URL=https://api.debatetimer.tonyxyz.com

# 若连本机 API（server 在 3001）：
# VITE_API_BASE_URL=
# VITE_DEV_API_PROXY=http://127.0.0.1:3001
