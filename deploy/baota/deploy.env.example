# 复制为同目录下的 deploy.env 后按机器改。deploy.env 不要提交到 Git。
#   cp deploy/baota/deploy.env.example deploy/baota/deploy.env
#
# 前端走 GitHub Pages（推送 deploy/production）。
# 本脚本只更新宝塔上的 API；MongoDB 数据不会动。

# Node 代码仓库（server/index.js 在此目录下的 server/）
APP_DIR=/www/wwwroot/debatetimer-api

# 宝塔反代站点目录（Nginx 网站根，里面不是 Node 源码）
PROXY_SITE=/www/wwwroot/api.debatetimer.tonyxyz.com

# 与 GitHub Pages 发版同一条分支
GIT_BRANCH=deploy/production

# 只部署 API（前端不发布到宝塔网站目录）
DEPLOY_TARGET=api

# API 健康检查（Nginx 反代到 Node 的本机地址）
HEALTH_URL=http://127.0.0.1:3001/health

# 重启 API 的方式（按你在宝塔里怎么跑 Node 选一个，留空则自动探测）
#   pm2        — 任意一份 pm2 里 cwd 属于 APP_DIR 的应用
#   baota      — 宝塔「网站 → Node 项目」生成的启动脚本
#   systemd    — 使用本目录提供的 debatetimer-api.service
#   command    — 自定义 RESTART_CMD
#
# 生产实测：/usr/bin/pm2 和 /www/server/nodejs/v24.16.0/bin/pm2 的 list 都为空。
# 宝塔「网站 → Node 项目」用启动脚本（nohup npm run start），不是 pm2：
#   /www/server/nodejs/vhost/scripts/debatetimer-api-server.sh
#   pid: /www/server/nodejs/vhost/pids/debatetimer-api-server.pid
#   日志: /www/wwwlogs/nodejs/debatetimer-api-server.log
# 生产：两份 pm2 list 都为空，必须走宝塔启动脚本。
BAOTA_NODE_SCRIPT=/www/server/nodejs/vhost/scripts/debatetimer-api-server.sh
RESTART_WITH=baota
# SYSTEMD_UNIT=debatetimer-api
# RESTART_CMD='bash /www/server/nodejs/vhost/scripts/debatetimer-api-server.sh'

# GitHub webhook.php 用的密钥（与 GitHub Webhook Secret 相同）。不用 webhook 可留空。
# WEBHOOK_SECRET=
