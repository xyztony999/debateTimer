# 复制为同目录下的 deploy.env 后按机器改。deploy.env 不要提交到 Git。
#   cp deploy/baota/deploy.env.example deploy/baota/deploy.env
#
# 前端走 GitHub Pages（推送 deploy/production）。
# 本脚本只更新宝塔上的 API；MongoDB 数据不会动。

# 仓库在服务器上的路径（git clone 的位置）
APP_DIR=/www/wwwroot/debatetimer

# 与 GitHub Pages 发版同一条分支
GIT_BRANCH=deploy/production

# 只部署 API（前端不发布到宝塔网站目录）
DEPLOY_TARGET=api

# API 健康检查（Nginx 反代到 Node 的本机地址）
HEALTH_URL=http://127.0.0.1:3001/health

# 重启 API 的方式（按你在宝塔里怎么跑 Node 选一个，留空则自动探测）
#   pm2        — 宝塔 Node 项目 / 自建 PM2，应用名见 PM2_APP
#   systemd    — 使用本目录提供的 debatetimer-api.service
#   command    — 自定义 RESTART_CMD
# RESTART_WITH=pm2
PM2_APP=debatetimer-api
# SYSTEMD_UNIT=debatetimer-api
# RESTART_CMD='pm2 restart debatetimer-api'

# GitHub webhook.php 用的密钥（与 GitHub Webhook Secret 相同）。不用 webhook 可留空。
# WEBHOOK_SECRET=
