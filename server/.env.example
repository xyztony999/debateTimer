# 监听端口（宝塔 Nginx 反代到此端口）
PORT=3001

# MongoDB 连接 — 宝塔默认开启认证，必须填写用户名密码
#
# 方式 A：完整 URI（密码含特殊字符请 URL 编码）
# MONGODB_URI=mongodb://debatetimer:YOUR_PASSWORD@127.0.0.1:27017/debatetimer?authSource=debatetimer
#
# 若用户在 admin 库创建，authSource 改为 admin：
# MONGODB_URI=mongodb://root:YOUR_PASSWORD@127.0.0.1:27017/debatetimer?authSource=admin

# 方式 B：分项填写（未设置 MONGODB_URI 时生效）
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DB=debatetimer
MONGODB_USER=debatetimer
MONGODB_PASSWORD=YOUR_PASSWORD
MONGODB_AUTH_SOURCE=debatetimer

# 允许跨域的前端来源，逗号分隔（必须列出具体来源，不能用 *，因为登录 cookie 需要 credentials）
ALLOWED_ORIGINS=https://debatetimer.tonyxyz.com,http://localhost:3000

# 首个注册用户自动成为管理员。之后默认关闭公开注册，由管理员在后台开账号。
# ALLOW_REGISTRATION=true

# Cookie（宝塔 HTTPS 生产环境请打开 COOKIE_SECURE=true）
# SESSION_COOKIE_NAME=dt_session
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# 宝塔部署说明见仓库 deploy/baota/README.md
